# BudgetBot Environment Variables
# Copy this file to .env and customize as needed

# Flask/Application settings
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database settings
DATABASE_URL=sqlite:///budgetbot.db
# For PostgreSQL: DATABASE_URL=postgresql://username:password@localhost:5432/budgetbot
SQLALCHEMY_TRACK_MODIFICATIONS=False
SQLALCHEMY_ECHO=False

# Redis settings (for caching/sessions)
REDIS_URL=redis://localhost:6379/0

# WhatsApp Business API settings (to be configured later)
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=budgetbot_verify_token

# Google Cloud / Sheets settings (to be configured later)
GOOGLE_SHEETS_CREDENTIALS=path/to/google/sheets/credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# AI/ML settings (to be configured later)
CLAUDE_API_KEY=your_claude_api_key_here
WHISPER_MODEL_PATH=./models/whisper
SARVAM_AI_KEY=your_sarvam_ai_key_here

# OCR settings (to be configured later)
TESSERACT_PATH=/usr/bin/tesseract  # Linux path example
GOOGLE_VISION_CREDENTIALS=path/to/google/vision/credentials.json

# File upload settings
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=./uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,bmp,tiff,pdf

# BudgetBot specific settings
CURRENCY=INR
DATE_FORMAT=%Y-%m-%d
DATETIME_FORMAT=%Y-%m-%d %H:%M:%S

# Feature flags
ENABLE_VOICE_PROCESSING=False
ENABLE_OCR_PROCESSING=False
ENABLE_ANALYTICS=True