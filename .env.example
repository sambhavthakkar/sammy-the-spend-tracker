# BudgetBot — copy to .env and fill in values you need.
# Everything else has safe defaults in src/config.py (you can omit it).

# ── Required for the AI agent ──────────────────────────────────
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b-cloud

# ── Required only for Telegram ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Optional: only these Telegram user IDs can use the bot (comma-separated, no spaces required)
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# Edit this while the bot is running — allowlist reloads on the next message.

# ── Bill photos (Gemma vision on Ollama — same OLLAMA_MODEL) ───
ENABLE_BILL_VISION=True

# ── Voice STT (Telegram voice notes) ───────────────────────────
ENABLE_VOICE_PROCESSING=True
# auto = faster_whisper then openai-compatible HTTP
STT_PROVIDER=auto
# faster-whisper sizes: tiny | base | small | medium
# openai API model: whisper-1
STT_MODEL=base
# empty = auto language; or en / hi
# STT_LANGUAGE=
# Optional OpenAI-compatible STT (if not using local faster-whisper):
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_SHOW_TRANSCRIPT=True

# ── Speed ──────────────────────────────────────────────────────
# Simple "lunch 250" skips Gemma (much faster). Questions still use the model.
AGENT_FAST_PATH=True
OLLAMA_MAX_TOOL_ROUNDS=4
# Bill photos: max edge px / JPEG quality (lower = faster upload to Gemma)
# BILL_IMAGE_MAX_SIDE=1280
# BILL_IMAGE_JPEG_QUALITY=75

# ── Optional overrides (defaults are usually fine) ─────────────
# DATABASE_URL=sqlite:///budgetbot.db
# AGENT_TIMEZONE_DEFAULT=Asia/Kolkata
# AGENT_CURRENCY_DEFAULT=INR
# LLM_TOOL_MODE=native
# DEBUG=False
