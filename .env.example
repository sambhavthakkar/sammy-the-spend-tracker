# BudgetBot — copy to .env and fill in values you need.
# Everything else has safe defaults in src/config.py (you can omit it).

# ── Required for the AI agent ──────────────────────────────────
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b-cloud

# ── Required only for Telegram ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Optional: only these Telegram user IDs can use the bot (comma-separated)
# TELEGRAM_ALLOWED_USER_IDS=123456789

# ── Optional overrides (defaults are usually fine) ─────────────
# DATABASE_URL=sqlite:///budgetbot.db
# AGENT_TIMEZONE_DEFAULT=Asia/Kolkata
# AGENT_CURRENCY_DEFAULT=INR
# LLM_TOOL_MODE=native
# DEBUG=False
