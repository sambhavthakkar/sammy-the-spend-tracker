# Required for chat and bill understanding
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_MAX_CONCURRENCY=4

# Required for Telegram. The allowlist is fail-closed for privacy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_CONCURRENT_UPDATES=8

# Private storage: persist and back up this directory
PERSONAL_DATA_DIR=./personal_data
AGENT_CLI_USER_ID=default
AGENT_TIMEZONE_DEFAULT=Asia/Kolkata
AGENT_CURRENCY_DEFAULT=INR
AGENT_CONFIRM_AMOUNT_THRESHOLD=10000
AGENT_MEMORY_TURNS=8
OLLAMA_MAX_TOOL_ROUNDS=4

# Voice notes
ENABLE_VOICE_PROCESSING=True
STT_PROVIDER=auto
STT_MODEL=base
# STT_LANGUAGE=
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_SHOW_TRANSCRIPT=True
STT_MAX_CONCURRENCY=1

# Bill photos
ENABLE_BILL_VISION=True
BILL_VISION_MAX_CONCURRENCY=2
# BILL_IMAGE_MAX_SIDE=1280
# BILL_IMAGE_JPEG_QUALITY=75
